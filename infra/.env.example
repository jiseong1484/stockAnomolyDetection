# Copy this file to infra/.env and fill in real values.
# infra/.env is gitignored (see root .gitignore's ".env" rule) — never commit it.

MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_PASSWORD=changeme-user

INFLUXDB_PASSWORD=changeme-influx-admin
INFLUXDB_TOKEN=changeme-influx-token

# Generate with: openssl rand -base64 32
JWT_SECRET=
# Must decode to exactly 32 bytes (AES-256). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
